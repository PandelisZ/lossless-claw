{
  "name": "@pandelis/lossless-claw",
  "version": "1.3.0-turbopuffer.0",
  "description": "Pandelis fork of Lossless Claw with opt-in experimental Turbopuffer context storage",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lcm": "dist/cli.js",
    "lossless-claw-migrate-sessions": "dist/migrate-sessions.js"
  },
  "license": "MIT",
  "author": "Josh Lehman <josh@martian.engineering>",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "context-management",
    "llm",
    "summarization",
    "conversation-memory",
    "dag"
  ],
  "scripts": {
    "build": "npm run build:plugin && npm run build:migrate-sessions && npm run build:cli && npm run build:ui && npm run build:experimental-storage",
    "build:plugin": "esbuild index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:openclaw --external:\"@earendil-works/*\" --minify-whitespace --external:pg",
    "build:migrate-sessions": "esbuild src/cli/migrate-sessions.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/migrate-sessions.js --external:openclaw --external:\"@earendil-works/*\" --minify-whitespace --external:pg",
    "build:cli": "esbuild cli.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/cli.js --minify-whitespace --external:pg",
    "changeset": "changeset",
    "plugin-inspector:ci": "npm exec --yes --package @openclaw/plugin-inspector@0.3.11 -- plugin-inspector ci --plugin-root . --out plugin-inspector-reports",
    "release:verify": "npm run typecheck && npm run build && npm test && npm run test:tui && npm pack --dry-run",
    "test": "vitest run --dir test",
    "test:tui": "cd tui && go test ./...",
    "typecheck": "tsc --noEmit --pretty false && tsc -p tsconfig.ui.json",
    "version-packages": "changeset version",
    "build:ui": "esbuild ui/control-ui.ts --bundle --platform=browser --target=es2022 --format=esm --outfile=dist/control-ui/index.js --minify",
    "build:experimental-storage": "esbuild src/storage/context-storage.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/experimental/context-storage.js --external:openclaw --external:\"@earendil-works/*\""
  },
  "files": [
    "dist/",
    "doctor-contract-api.d.ts",
    "doctor-contract-api.js",
    "skills/",
    "openclaw.plugin.json",
    "docs/",
    "!docs/superpowers/",
    "README.md",
    "LICENSE",
    "!docs/experiments/turbopuffer/evidence/"
  ],
  "dependencies": {
    "@sinclair/typebox": "0.34.48",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@earendil-works/pi-agent-core": "^0.79.8",
    "@earendil-works/pi-ai": "^0.79.8",
    "@earendil-works/pi-coding-agent": "^0.79.8",
    "@types/pg": "^8.23.1",
    "dompurify": "^3.4.15",
    "esbuild": "^0.28.1",
    "marked": "^18.0.13",
    "openclaw": "2026.9.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "turbopuffer"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.2",
      "minGatewayVersion": "2026.9.2",
      "tested": [
        "2026.9.4",
        "2026.9.5"
      ]
    },
    "build": {
      "openclawVersion": "2026.9.4"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PandelisZ/lossless-claw.git"
  },
  "homepage": "https://github.com/PandelisZ/lossless-claw#readme",
  "bugs": {
    "url": "https://github.com/PandelisZ/lossless-claw/issues"
  }
}
